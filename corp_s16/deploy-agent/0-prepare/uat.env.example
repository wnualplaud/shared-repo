# every key the deploy scripts read; copy to deliverables/local/uat.env and fill in
# (rehearsal: deliverables/local/rehearsal.env holds the same keys)
AWS_PROFILE=AdministratorAccess-<account_id>
AWS_REGION=ap-southeast-7
ACCOUNT_ID=<account_id>
ECR_REPO=rdx-uat-your-data
CLUSTER=rdx-uat-ecs
SERVICE=rdx-uat-ecs
CONTAINER=app
LOG_GROUP=/ecs/rdx-uat-ecs
# smoke (4b), all optional: empty base URL = found from the service's load balancer;
# empty test keys = dummy values (data calls answer 4xx; until there is mock data)
SMOKE_BASE_URL=
SMOKE_ACCOUNT_ID=
SMOKE_CITIZEN_ID=
SMOKE_SUBTYPE=SAVING
