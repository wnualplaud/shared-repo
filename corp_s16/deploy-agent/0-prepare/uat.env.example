# every key the deploy scripts read; copy to deliverables/local/uat.env and fill in
# (rehearsal: deliverables/local/rehearsal.env holds the same keys)
AWS_PROFILE=AdministratorAccess-<account_id>
AWS_REGION=ap-southeast-7
ACCOUNT_ID=<account_id>
ECR_REPO=rdx-uat-your-data
CLUSTER=rdx-uat-ecs
SERVICE=rdx-uat-ecs
CONTAINER=app
LOG_GROUP=/ecs/rdx-uat-ecs
# optional: container env values to set in the new revision (each name must exist in it already);
# api r06 c12 (our mock stores): TASK_ENV="APP_ENV=uatmock ATHENA_DATABASE=rdxuatmock_db1"
# rewire to the real stores (work-inventory G13): TASK_ENV="APP_ENV=uat ATHENA_DATABASE=rdxuat_db1"
TASK_ENV=
# smoke (4b), all optional: empty base URL = found from the service's load balancer;
# empty test keys = dummy values (data calls answer 4xx); with the testbed mock
# (api r06 c11): SMOKE_ACCOUNT_ID=1234567001 SMOKE_CITIZEN_ID=1234567890001 -> all five 200
SMOKE_BASE_URL=
SMOKE_ACCOUNT_ID=
SMOKE_CITIZEN_ID=
SMOKE_SUBTYPE=SAVINGS
