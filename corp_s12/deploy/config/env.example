# Template for config/<env>.env: every key the scripts and templates read.
# Copy to config/<env>.env and fill. Values here are placeholders only.
# Adding a key? Add it here AND in every real <env>.env (compare-env.sh checks both ways).

AWS_PROFILE="<sso-profile>"
AWS_REGION="<region>"

APP="<app-name>"
CLUSTER="<ecs-cluster>"
FAMILY="<task-definition-family>"
TASK_ROLE="<task-role-name>"
EXECUTION_ROLE="<execution-role-name>"

IMAGE_REPO="<ecr-repository>"
IMAGE_TAG="<image-tag>"

LOG_GROUP="</ecs/log-group>"
LOG_PREFIX="<log-stream-prefix>"

# app runtime config
APP_ENV="<dev|sit|uat|prod>"
ATHENA_DATABASE="<athena-database>"
ATHENA_WORKGROUP="<athena-workgroup>"
ATHENA_QUERY_TIMEOUT_SECONDS="<seconds>"

# S3: query results and Athena table data
BUCKET="<bucket-name>"
ATHENA_RESULTS_PREFIX="<prefix-without-slashes>"
MART_DATA_PREFIX="<prefix-without-slashes>"

# DynamoDB tables the task role may read (must match the query table names for APP_ENV)
TABLE_AC_LIST="<account-list-table>"
TABLE_AC_DTL="<account-detail-table>"

# network for run-task / service (comma-separated ids, no spaces)
SUBNETS="<subnet-id>,<subnet-id>"
SECURITY_GROUPS="<sg-id>"
ASSIGN_PUBLIC_IP="<ENABLED|DISABLED>"
