{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoReadEndpointTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PartiQLSelect",
        "dynamodb:ExecuteStatement"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-southeast-7:<ACCOUNT_ID>:table/rdxuat_tbl1",
        "arn:aws:dynamodb:ap-southeast-7:<ACCOUNT_ID>:table/rdxuat_tbl2"
      ]
    },
    {
      "Sid": "AthenaRunQueries",
      "Effect": "Allow",
      "Action": [
        "athena:StartQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetQueryResults",
        "athena:StopQueryExecution"
      ],
      "Resource": "arn:aws:athena:ap-southeast-7:<ACCOUNT_ID>:workgroup/<ATHENA_WORKGROUP>"
    },
    {
      "Sid": "GlueReadCatalog",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase",
        "glue:GetTable",
        "glue:GetPartitions"
      ],
      "Resource": [
        "arn:aws:glue:ap-southeast-7:<ACCOUNT_ID>:catalog",
        "arn:aws:glue:ap-southeast-7:<ACCOUNT_ID>:database/rdxuat_db1",
        "arn:aws:glue:ap-southeast-7:<ACCOUNT_ID>:table/rdxuat_db1/*"
      ]
    },
    {
      "Sid": "S3ReadMartData",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::<MART_DATA_BUCKET>/<MART_DATA_PREFIX>/*"
    },
    {
      "Sid": "S3BucketLevel",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::<MART_DATA_BUCKET>",
        "arn:aws:s3:::<ATHENA_RESULTS_BUCKET>"
      ]
    },
    {
      "Sid": "S3AthenaResults",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::<ATHENA_RESULTS_BUCKET>/athena-results/serving-api/*"
    }
  ]
}
